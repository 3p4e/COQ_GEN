# .env.example — copy to .env for local dev (never commit real secrets).
# Core API (local sidecar, localhost-only)
COQGEN_DATABASE_URL=postgresql+psycopg://coqgen:coqgen@127.0.0.1:5432/coqgen_dev
COQGEN_BIND_HOST=127.0.0.1
COQGEN_BIND_PORT=8765
COQGEN_SESSION_TOKEN=dev-session-token

# Letta agent gateway (KVM4)
COQGEN_GATEWAY_URL=https://kvm4.internal/coqgen-gateway/v1
COQGEN_GATEWAY_TOKEN=

# Gateway service (runs on KVM4) -> Letta
LETTA_BASE_URL=
LETTA_TOKEN=
