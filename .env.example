# .env.example — copy to .env for local dev (never commit real secrets).

# --- planner_api (FastAPI backend, localhost) ---
PLANNER_DATABASE_URL=postgresql+psycopg://planner:planner@127.0.0.1:5432/planner_dev
PLANNER_BIND_HOST=127.0.0.1
PLANNER_BIND_PORT=8765
PLANNER_JWT_SECRET=dev-insecure-jwt-secret-change-me
# CORS origins the web app is served from (JSON list); defaults cover Vite dev/preview.
PLANNER_CORS_ORIGINS=["http://127.0.0.1:5174","http://localhost:5174"]
# planner_api -> gateway (AI degrades gracefully when these are unset)
PLANNER_GATEWAY_URL=
PLANNER_GATEWAY_TOKEN=

# --- web (Vite) ---
VITE_PLANNER_API=http://127.0.0.1:8765

# --- gateway/ (Letta gateway container; runs inside the Letta stack on KVM4) ---
GATEWAY_BIND_HOST=0.0.0.0
GATEWAY_BIND_PORT=8800
GATEWAY_LETTA_BASE_URL=http://letta:8283
GATEWAY_LETTA_TOKEN=
# Agent IDs default to the provisioned planner agents; override only if they change.
# GATEWAY_AGENT_WEEKLY_REPORT=agent-c783d24a-9d85-4b0b-8882-e210f504504a
# GATEWAY_AGENT_NEXT_WEEK_PLAN=agent-815929b3-8ffb-4671-992b-ee7d55273f24
# GATEWAY_AGENT_TASK_REWRITE=agent-e8518fbc-29a2-4585-8ba8-7cb45a936a18
# GATEWAY_AGENT_EXECUTIVE_ANALYTICS=agent-e72faed9-38f8-4808-9dde-2fac12038f22
